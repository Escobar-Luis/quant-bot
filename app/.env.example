# Copy to app/.env and fill in. Never commit app/.env.

# Nicrron API (required): nicrron.ai/dashboard/keys
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=nicrron/auto

# PRISM by Block Convey (required): prism.blockconvey.com → Settings → API Keys
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://api.prism.blockconvey.com

# ElevenLabs (optional): elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
